fn formax(a,b) {
    //file.write("test.txt", "");
    set aa = a.split("");
    if (aa.len < b) {
        set x = a.float;
    } else {
        set i = 0;
        for..in i b+2 {
            file.append("test.txt", aa[i]);
            i = i + 1;
        }
        set lin = file.read("test.txt");
        set x = lin.float;
    }
    return x;
}

