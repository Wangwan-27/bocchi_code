fn min(...nums) {
    if (nums.len == 0) {
        return void;
    }
    set m = nums[0];
    for v in nums {
        if (v < m) {
            m = v;
        }
    }
    return m;
}

fn max(...nums) {
    if (nums.len == 0) {
        return void;
    }
    set m = nums[0];
    for v in nums {
        if (v > m) {
            m = v;
        }
    }
    return m;
}
