fn isString(x) {
    try {
        set t = x.split("");
        return true;
    } expect(e) {
        return false;
    }
}

fn isBool(x) {
    return x == true or x == false;
}

fn isList(x) {
    try {
        set t = x.len;
        return true;
    } expect(e) {
        return false;
    }
}

fn isDict(x) {
    try {
        set t = x["__io3_probe__"];
        return true;
    } expect(e) {
        return false;
    }
}

// 统一类型名
fn typeOf(x) {
    if (isBool(x))   { return "bool"; }
    if (isNumber(x)) { return "num"; }
    if (isString(x)) { return "str"; }
    if (isList(x))   { return "list"; }
    if (isDict(x))   { return "dict"; }
    return "unknown";
}

