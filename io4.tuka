// 随机选列表一个元素
fn choice(list1) {
    if (list1.len == 0) {
        return void;
    }
    return list1[rand(0, list1.len - 1)];
}

//puts choice([1,2,3,4,5]);


//排序 第一参数为列表，第二参数为是否降序，默认升序
fn sort(arr, reverse = false) {
    set n = arr.len;
    for..in i n {
        set j = i + 1;
        loop (j < n) {
            set need = false;
            if (reverse) {
                if (arr[j] > arr[i]) { need = true; }
            } else {
                if (arr[j] < arr[i]) { need = true; }
            }
            if (need) {
                set t = arr[i];
                arr[i] = arr[j];
                arr[j] = t;
            }
            j = j + 1;
        }
    }
    return arr;
}

