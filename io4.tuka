// 列表是否包含某值
fn isinlist(list1, value) {
    for v in list1 {
        if (v == value) {
            return true;
        }
    }
    return false;
}

//puts isinlist([1,2,3,4,5],3);

// 查找元素下标，找不到返回 -1
fn indexof(list1, value) {
    set i = 0;
    for v in list1 {
        if (v == value) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

//puts indexof([1,2,3,4,5],3);

// 计数：某值出现了几次
fn countof(list1, value) {
    set c = 0;
    for v in list1 {
        if (v == value) {
            c = c + 1;
        }
    }
    return c;
}

//puts countof([1,2,3,4,5,3],3);

// 拼接列表为字符串
fn join(list1, sep) {
    set result = "";
    set first = true;
    for v in list1 {
        if (first) {
            result = result + v.string;
            first = false;
        } else {
            result = result + sep + v.string;
        }
    }
    return result;
}

//puts join([1,2,3,4,5],".");

// 绝对值
fn abs(x) {
    if (x < 0) {
        return 0 - x;
    }
    return x;
}

//puts abs(-10);

fn trim(s) {
    set x = s.replace(" ", "").string;   // 注意：这个语言没有 trim，只能简化成去空格
    return x;
}

//puts trim("  123  ");

// 重复字符串 n 次
fn repeatString(s, n) {
    set result = "";
    for..in i n {
        result = result + s;
    }
    return result;
}

//puts repeatString("hello",3);

// 左填充：padleft("5", "0", 3) → "005"
fn padLeft(s, pad, total) {
    set result = s;
    loop (result.split("").len < total) {
        result = pad + result;
    }
    return result;
}

// 右填充：padright("5", "0", 3) → "500"
fn padRight(s, pad, total) {
    set result = s;
    loop (result.split("").len < total) {
        result = result + pad;
    }
    return result;
}

//puts padLeft("5", "0", 3);
//puts padRight("5", "0", 3);

