fn sum(...nums) {
    set total = 0;
    for v in nums {
        total = total + v;
    }
    return total;
}

fn avg(...nums) {
    set total = 0;
    set count = 0;
    for v in nums {
        total = total + v;
        count = count + 1;
    }
    if (count == 0) {
        return void;
    }
    return total / count;
}

